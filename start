#!/bin/bash
cd "$(dirname "$0")"

if [ -d ".venv" ]; then
    source .venv/bin/activate
else
    echo "⚠️  Virtual environment not found. Creating..."
    python3 -m venv .venv
    source .venv/bin/activate
    pip install --upgrade pip
    pip install -r requirements.txt
fi

if [ "${YTD_SKIP_UPDATE:-0}" != "1" ]; then
    STAMP="$HOME/.yt_downloader/.ytdlp_update_check"
    if [ ! -f "$STAMP" ] || [ -n "$(find "$STAMP" -mtime +1 2>/dev/null)" ]; then
        echo "⏳ Kontroluji aktualizaci yt-dlp (max 1× denně)…"
        if pip install -qU yt-dlp >/dev/null 2>&1; then
            mkdir -p "$(dirname "$STAMP")" && touch "$STAMP"
            echo "yt-dlp: $(python -m yt_dlp --version 2>/dev/null)"
        else
            echo "⚠️  yt-dlp update přeskočen (offline?). Ruční: pip install -U yt-dlp"
        fi
    fi
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "⚠️  ffmpeg not found. Install with: brew install ffmpeg"
fi

if ! command -v deno >/dev/null 2>&1 \
   && ! command -v node >/dev/null 2>&1 \
   && ! command -v bun >/dev/null 2>&1; then
    echo "⚠️  Žádný JS runtime (deno/node/bun). Doporučeno: brew install deno"
fi

python app/bootstrap.py
